# Copia este archivo a .env para desarrollo local.
# Columna "dónde": V = Vercel (app Next.js), W = Railway (worker), L = solo local

# ── Base de datos (Neon en producción) ─────────────────── V W
# Con pooler (host con "-pooler"): la usan las funciones serverless y el worker
DATABASE_URL="postgresql://finance:finance@localhost:5433/finance_dashboard"
# Directa (sin pooler): solo para `prisma migrate deploy`. En local, la misma
DIRECT_URL="postgresql://finance:finance@localhost:5433/finance_dashboard"

# ── Redis (cola BullMQ) ───────────────────────────────── V W
# Vercel encola, el worker consume. En Railway usa la URL pública en Vercel
# y la privada (redis.railway.internal) en el worker.
REDIS_URL="redis://localhost:6379"

# ── NextAuth ──────────────────────────────────────────── V
# Producción: https://<tu-app>.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Google OAuth ──────────────────────────────────────── V
# Redirect URI autorizada: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Plaid ─────────────────────────────────────────────── V W
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Solo producción: https://<tu-app>.vercel.app/api/plaid/webhook
# Vacío en local (Plaid no puede llegar a localhost)
PLAID_WEBHOOK_URL=""

# ── IA (categorización) ───────────────────────────────── W
GEMINI_API_KEY=""
