generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankConnections BankConnection[]

  @@map("users")
}

model BankConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plaidItemId      String  @unique
  plaidAccessToken String
  institutionName  String
  status           String  @default("ACTIVE") // "ACTIVE" | "ITEM_LOGIN_REQUIRED" | "ERROR"
  lastSyncedAt     DateTime?
  lastSyncCursor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]

  @@map("bank_connections")
}

model Account {
  id               String         @id @default(cuid())
  bankConnectionId String
  bankConnection   BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  plaidAccountId String  @unique
  name           String
  mask           String?
  type           String  // "checking" | "savings" | "credit_card" | etc.
  currentBalance Decimal @db.Decimal(14, 2)

  transactions Transaction[]

  @@map("accounts")
}
model Category {
  id       String  @id @default(cuid())
  userId   String? // null = categoría global del sistema
  name     String
  icon     String?
  color    String?
  isSystem Boolean @default(false)

  transactions Transaction[]
  categorizationCache  CategorizationCache[] 

  @@unique([userId, name])
  @@map("categories")
}

model Transaction {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  plaidTransactionId String @unique

  amount         Decimal  @db.Decimal(14, 2)
  date           DateTime @db.Date
  merchantName   String?
  rawDescription String
  normalizedDescription String

  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id])
  categorizationSource String    @default("UNCLASSIFIED") // "AI" | "CACHE" | "MANUAL" | "UNCLASSIFIED"

  isRecurring      Boolean @default(false)
  recurringGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, date])
  @@index([normalizedDescription])
  @@map("transactions")
}
model CategorizationCache {
  id                     String @id @default(cuid())
  normalizedDescription  String @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  confidence Float
  hitCount   Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("categorization_cache")
}