generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bankConnections BankConnection[]
  categories      Category[]
  authAccounts    Account_Auth[]
  sessions        Session[]

  @@map("users")

}

model BankConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plaidItemId      String  @unique
  plaidAccessToken String
  institutionName  String
  status           String  @default("ACTIVE") // "ACTIVE" | "ITEM_LOGIN_REQUIRED" | "ERROR"
  lastSyncedAt     DateTime?
  lastSyncCursor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]

  @@map("bank_connections")
}

model Account {
  id               String         @id @default(cuid())
  bankConnectionId String
  bankConnection   BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  plaidAccountId String  @unique
  name           String
  mask           String?
  type           String  // "checking" | "savings" | "credit_card" | etc.
  currentBalance Decimal @db.Decimal(14, 2)

  transactions Transaction[]

  @@map("accounts")
}
model Category {
  id       String  @id @default(cuid())
  userId   String? // null = categoría global del sistema
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  icon     String?
  color    String?
  isSystem Boolean @default(false)

  transactions Transaction[]
  categorizationCache  CategorizationCache[] 

  @@unique([userId, name])
  @@map("categories")
}

model Transaction {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  plaidTransactionId String @unique

  amount         Decimal  @db.Decimal(14, 2)
  date           DateTime @db.Date
  merchantName   String?
  rawDescription String
  normalizedDescription String

  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id])
  categorizationSource String    @default("UNCLASSIFIED") // "AI" | "CACHE" | "MANUAL" | "UNCLASSIFIED"

  isRecurring      Boolean @default(false)
  recurringGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, date])
  @@index([normalizedDescription])
  @@map("transactions")
}
model CategorizationCache {
  id                     String @id @default(cuid())
  normalizedDescription  String @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  confidence Float
  hitCount   Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("categorization_cache")
}

model Account_Auth {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
